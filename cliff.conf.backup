# =============================================================================
# cliff.conf — example configuration for git-cliff
# =============================================================================
#
# git-cliff (https://git-cliff.org) generates a changelog from your git
# history based on the Conventional Commits specification
# (https://www.conventionalcommits.org).
#
# Usage:
#
#   git cliff --config cliff.conf                    # preview on stdout
#   git cliff --config cliff.conf -o CHANGELOG.md    # write CHANGELOG.md
#
# git-cliff auto-detects a configuration file named `cliff.toml` (or
# `~/.config/git-cliff/cliff.toml`), so either pass this file explicitly as
# shown above, or copy it to that name:
#
#   cp cliff.conf cliff.toml
#
# With the settings below, the generated changelog looks like:
#
#   # Changelog
#
#   ## 1.2.3 - 2026-09-25
#
#   ### Features
#   - Add dark mode support
#
#   ### Bug Fixes
#   - Fix crash on startup
#
# Everything below is optional: git-cliff supplies defaults for every key, so
# treat this file as a menu — keep what you need and delete the rest.
# =============================================================================


# -----------------------------------------------------------------------------
# [changelog] — how the changelog document is rendered
#
# `header`, `body` and `footer` are Tera templates (a Jinja2-like syntax,
# see https://tera.netlify.app/docs/). The body template receives, among
# others:
#
#   version    release tag being rendered (e.g. "v1.2.3"), null when the
#              section is unreleased
#   timestamp  release time of that tag
#   commits    the release's parsed commits, grouped by their `group` value
#              from the commit_parsers below
#
# Note: a `\` at the end of a template line is a TOML line-continuation. It
# swallows the following newline so the `{% ... %}` control tags do not leave
# stray blank lines in the output.
# -----------------------------------------------------------------------------
[changelog]
# Title at the top of the file. The blank line below it separates the title
# from the first release heading.
header = """
# Changelog

"""

# One entry per release. `{% if version %}` distinguishes tagged releases from
# the "Unreleased" section git-cliff renders for commits that are newer than
# the newest tag.
body = """
{% if version %}\
## {{ version | trim_start_matches(pat="v") }} - {{ timestamp | date(format="%Y-%m-%d") }}
{% else %}\
## Unreleased
{% endif %}
{% for group, commits in commits | group_by(attribute="group") %}\
### {{ group | striptags | trim | upper_first }}
{% for commit in commits %}\
- {{ commit.message | split(pat="\\n") | first | trim | upper_first }}
{% endfor %}
{% endfor %}\
"""

# Footer of the file. The HTML comment marks the file as generated, so that
# hand-written notes above it are recognisable as such.
footer = """
<!-- generated by git-cliff -->
"""

# Strip leading/trailing whitespace from the rendered sections.
trim = true

# Rewrite the finished markdown before it is written or printed. `pattern`
# is a regex, `replace` supports capture groups (${1}, ${2}, ...).
# postprocessors = [
#   # Turn "#123" into a link to the issue tracker:
#   { pattern = '#(\\d+)', replace = '[#${1}](https://github.com/<owner>/<repo>/issues/${1})' },
# ]


# -----------------------------------------------------------------------------
# [git] — how commits and tags are read from the repository
# -----------------------------------------------------------------------------
[git]
# Interpret commits as Conventional Commits (`feat:`, `fix(scope):`,
# `feat!:`/`BREAKING CHANGE:`, ...).
conventional_commits = true

# Drop commits that are not conventional. Set this to false to keep them and
# route them yourself with the catch-all parser at the bottom of this file.
filter_unconventional = true

# Split a commit's message into several entries at blank lines. Only useful
# when commits deliberately pack several changes into one message.
split_commits = false

# Order commits within a section: "oldest" (chronological) or "newest" first.
sort_commits = "oldest"

# Cap the number of commits listed per section (useful for long histories).
# limit_commits = 100

# Fail with an error when a commit is not conventional — useful in CI.
# require_conventional = true

# Only tags matching this regex count as releases, e.g. to ignore pre-release
# tags such as v1.2.3-rc.1:
# tag_pattern = "^v[0-9]+\\.[0-9]+\\.[0-9]+$"

# Leave out releases whose tag matches this regex entirely.
# skip_tags = "^v[0-9]+\\.[0-9]+\\.[0-9]+-rc"

# Fold releases whose tag matches this regex into the next matching one: the
# commits still appear, just under the newer version heading.
# ignore_tags = "^v[0-9]+\\.[0-9]+\\.[0-9]+-rc"

# Rewrite commit messages before they are parsed and grouped.
# commit_preprocessors = [
#   { pattern = 'Signed-off-by: .*', replace = "" },   # drop sign-offs
# ]

# Keep commits with breaking changes even when a parser below sets
# `skip = true` for them.
# protect_breaking_commits = true

# -----------------------------------------------------------------------------
# commit parsers — map commits to changelog sections
#
# The first parser whose `message` regex matches the commit wins. The `group`
# values become the "###" headings in the changelog body template above, so
# rename them freely.
# -----------------------------------------------------------------------------
[[git.commit_parsers]]
message = "^feat"
group = "Features"

[[git.commit_parsers]]
message = "^fix"
group = "Bug Fixes"

[[git.commit_parsers]]
message = "^perf"
group = "Performance"

[[git.commit_parsers]]
message = "^refactor"
group = "Refactoring"

[[git.commit_parsers]]
message = "^docs"
group = "Documentation"

[[git.commit_parsers]]
message = "^test"
group = "Testing"

[[git.commit_parsers]]
message = "^style"
group = "Styling"

[[git.commit_parsers]]
message = "^ci"
group = "Continuous Integration"

# Version bumps have no place in the changelog.
[[git.commit_parsers]]
message = "^chore\\(release\\):"
skip = true

[[git.commit_parsers]]
message = "^chore"
group = "Miscellaneous Tasks"

[[git.commit_parsers]]
message = "^revert"
group = "Reverted"

# Catch-all: because `filter_unconventional = true` above, only conventional
# commits reach the parsers, so this section collects types that are not
# listed above instead of silently dropping them.
[[git.commit_parsers]]
message = ".*"
group = "Other"

# -----------------------------------------------------------------------------
# Protected tags — releases matching these patterns are never removed by
# `skip_tags` or by `skip = true` parsers, keeping history around releases
# intact.
# -----------------------------------------------------------------------------
# [git.protect]
# patterns = [
#   "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
# ]


# -----------------------------------------------------------------------------
# [remote] — optional forge integration
#
# With a remote enabled, git-cliff can add PR links, authors and avatars to
# each entry (the `commit.remote` fields in the Tera context). The lookups
# need network access, so this stays commented out by default.
#
# Never put API tokens in this file — it is committed to the repository.
# git-cliff reads credentials from the environment instead (GITHUB_TOKEN,
# GITLAB_TOKEN, GITEA_TOKEN, ...).
# -----------------------------------------------------------------------------
# [remote.github]
# owner = "your-org"
# repo = "your-repo"
