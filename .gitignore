# Ignore patterns for this repository.
#
# Trimmed down from the default template to what can plausibly appear here:
# this repository only contains documentation and configuration files
# (README, cliff.conf, CHANGELOG.md and a GitHub Actions workflow), so the
# stack-specific sections — dependencies, build output, coverage, logs,
# archives and the Node/Python/Rust tooling — were removed. Kept: OS files,
# common editor state, secrets and temporary files.

##### Operating systems #####

# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
Icon?
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:ignore
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

##### Editors & IDEs #####

# VS Code — this repo keeps no shared settings, so ignore the folder wholesale
.vscode/
.history/

# JetBrains (IntelliJ IDEA, PyCharm, WebStorm, ...) — .idea/ and *.iml cover
# the project state these IDEs write today
.idea/
*.iml

# Vim
*.sw[a-p]
.vim/
*.viminfo

# Emacs
\#*\#
.\#*
auto-save-list/
tramp

##### Secrets & credentials #####

# Environment files — no .env.example/.env.template exists to un-ignore
.env
.env.*

# Keys and certificates — never commit these
*.pem
*.key
*.p12
*.pfx
*.jks

##### Temporary & cache files #####

*.tmp
*.temp
*.bak
.cache/
tmp/
temp/

##### Project-specific (optional) #####

# Uncomment to ignore a local auto-detected git-cliff config copied from
# cliff.conf (see README) instead of committing the duplicate:
# cliff.toml
